{
  "$schema": "https://jolli.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "jollicode-local": {
      "path": "~/.local/share/jollicode",
      "description": "Contains jollicode logs and data",
    },
  },
  // The Jolliedu course-chat MCP server (`mcp.jolliedu`) is fetched from the tenant's
  // backend at startup — see `fetchJolliMcpConfig` in `packages/opencode/src/config/config.ts`.
  // Do NOT declare `mcp.jolliedu` here: whenever discovery succeeds its answer replaces a
  // local entry of that name as a whole, so nothing set here takes effect, and when discovery
  // fails a stale entry here would be connected instead of the server being absent.
  "mcp": {},
  "tools": {},
}
