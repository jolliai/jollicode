{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/sdk",
  "version": "1.18.31",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "generate": "bun ./script/generate.ts",
    "check:generated": "bun run generate && git add -N -- src/v2/gen && git diff --exit-code -- src/v2/gen",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./v2": "./src/v2/index.ts",
    "./v2/client": "./src/v2/client.ts",
    "./v2/gen/client": "./src/v2/gen/client/index.ts",
    "./v2/server": "./src/v2/server.ts",
    "./v2/types": "./src/v2/gen/types.gen.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.10",
    "@tsconfig/node22": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "cross-spawn": "catalog:"
  }
}
