#!/usr/bin/env bash
set -euo pipefail

# Get the latest Git tag; before the first vscode-v* tag exists, fall back to package.json
latest_tag=$(git tag --sort=committerdate | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | tail -1 || true)
if [ -n "$latest_tag" ]; then
    echo "Latest tag: $latest_tag"
    version=$(echo "$latest_tag" | sed 's/^vscode-v//')
else
    echo "No tags found, using package.json version"
    version=$(node -p "require('./package.json').version")
fi
echo "Version: $version"

# package-marketplace
vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o dist/jollicode.vsix "$version"

# publish-marketplace
vsce publish --packagePath dist/jollicode.vsix

# publish-openvsx
npx ovsx publish dist/jollicode.vsix -p "$OPENVSX_TOKEN"
