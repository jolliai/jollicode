#!/usr/bin/env bash
set -euo pipefail

# VERSION is the top "## MAJOR.MINOR.PATCH" section of CHANGELOG.md, which vsce also packages as the
# extension's changelog on both marketplaces. package.json keeps a 0.0.0 placeholder that releases never
# read or update: the version is passed to vsce package below.
: "${VERSION:?VERSION is required}"
echo "Version: $VERSION"

# A section that was never bumped still names the last release, so refuse it before publishing.
latest_version=$(git tag --list 'vscode-v*' | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^vscode-v//' | sort -V | tail -1 || true)
if [ -n "$latest_version" ]; then
    echo "Latest release: $latest_version"
    if [ "$(printf '%s\n%s\n' "$latest_version" "$VERSION" | sort -V | tail -1)" != "$VERSION" ] || [ "$latest_version" = "$VERSION" ]; then
        echo "sdks/vscode/CHANGELOG.md names $VERSION, which is not newer than the published $latest_version; add a section for the new release" >&2
        exit 1
    fi
fi

# package-marketplace
vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o dist/jollicode.vsix "$VERSION"

# A rerun after one marketplace succeeded skips it instead of failing on the duplicate version. Both
# tools only log the skip, so raise it as a warning: a skip on a fresh release means nothing was published.
publish_to() {
    local name=$1
    shift
    local log
    log=$(mktemp)
    "$@" 2>&1 | tee "$log"
    if grep -q "is already published. Skipping publish." "$log"; then
        echo "::warning::$name already has $VERSION, so this run did not publish it there"
    fi
}

publish_to "VS Code Marketplace" vsce publish --skip-duplicate --packagePath dist/jollicode.vsix
publish_to "Open VSX" npx ovsx publish dist/jollicode.vsix --skip-duplicate -p "$OPENVSX_TOKEN"
